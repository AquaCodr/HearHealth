# 依赖（云端/本地会重新安装，不需要提交）
node_modules/
miniprogram_npm/

# 微信开发者工具本地编译缓存
miniprogram/dist/
cloudfunctions/*/dist/
project.private.config.json

# 本地调试与日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# 项目辅助数据（AI 工具配置，非源码）
.codebuddy/

# 敏感信息：本地密钥/环境配置（如有）
.env
.env.local

# Claude Code 本地配置
.claude/settings.local.json
