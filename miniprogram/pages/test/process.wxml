<view class="container process-page">
  <view class="progress-section">
    <view class="step-row {{barFused ? 'step-row--fused' : ''}}">
      <view class="step-item step-item--{{item.status}}" wx:for="{{steps}}" wx:key="label">
        <view class="step-segment step-segment--{{item.status}}"></view>
        <view class="step-label step-label--{{item.status}}">{{item.label}}</view>
      </view>
    </view>
  </view>

  <block wx:if="{{currentStep === 1}}">
    <view class="process-screen">
      <view class="process-content">
        <view class="intro-block">
          <view class="intro-kicker">STEP 1</view>
          <view class="intro-title">准备测试</view>
          <view class="intro-description">安静环境，戴好耳机，音量保持不变。</view>
        </view>

        <view class="setup-panel">
          <view class="channel-row">
            <view class="channel-item">
              <view class="channel-badge">L</view>
              <view class="channel-name">左耳</view>
            </view>
            <view class="channel-divider"></view>
            <view class="channel-item">
              <view class="channel-badge">R</view>
              <view class="channel-name">右耳</view>
            </view>
          </view>

          <view class="preparation-list">
            <view
              class="preparation-item"
              wx:for="{{preparationItems}}"
              wx:key="*this"
            >
              <view class="preparation-check" aria-hidden="true">✓</view>
              <view class="preparation-text">{{item}}</view>
            </view>
          </view>
        </view>

        <view class="safety-note">
          <view class="safety-title">如感到刺耳、疼痛或明显不适，请立即停止。</view>
        </view>
      </view>

      <view class="process-actions">
        <button class="ready-button" hover-class="ready-button--pressed" bindtap="startLeftEar">开始左耳测试</button>
        <view class="action-hint">从 125 Hz 的轻音开始</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{currentStep === 2 || currentStep === 3}}">
    <block wx:if="{{!currentEarCompleted}}">
      <view class="process-screen">
        <view class="process-content process-content--testing">
          <view class="test-header">
            <view class="test-ear-badge">{{currentEarCode}}</view>
            <view class="test-header-copy">
              <view class="intro-kicker">STEP {{currentStep}}</view>
              <view class="test-title">{{currentEarName}}测试</view>
            </view>
            <view class="frequency-count">{{currentFrequencyIndex + 1}} / {{frequencies.length}}</view>
          </view>

          <view class="tone-orb tone-orb--{{autoPhase}}">
            <view class="tone-orb-fill" style="height: {{currentLevelPercent}}%;">
              <view class="tone-orb-wave"></view>
            </view>
            <view class="tone-orb-content">
              <block wx:if="{{autoPhase === 'countdown'}}">
                <view class="orb-countdown">{{countdownSeconds}}</view>
                <view class="orb-label">准备播放</view>
              </block>
              <block wx:elif="{{autoPhase === 'playing' || autoPhase === 'waiting'}}">
                <view class="orb-wave-icon" aria-hidden="true">
                  <view class="orb-wave-bar orb-wave-bar--one"></view>
                  <view class="orb-wave-bar orb-wave-bar--two"></view>
                  <view class="orb-wave-bar orb-wave-bar--three"></view>
                </view>
                <view class="orb-label">{{currentLevelPercent}}%</view>
              </block>
              <block wx:elif="{{autoPhase === 'recorded'}}">
                <view class="orb-check" aria-hidden="true">✓</view>
                <view class="orb-label">已记录</view>
              </block>
              <block wx:elif="{{autoPhase === 'error'}}">
                <view class="orb-error" aria-hidden="true">!</view>
                <view class="orb-label">需重试</view>
              </block>
              <block wx:else>
                <view class="orb-idle" aria-hidden="true">…</view>
                <view class="orb-label">等待中</view>
              </block>
            </view>
          </view>

          <view class="frequency-card">
            <view class="frequency-header">
              <view class="frequency-label">当前频率</view>
              <view class="frequency-value">{{currentFrequency}} <text class="frequency-unit">Hz</text></view>
            </view>

            <view class="relative-level">
              <view class="relative-level-header">
                <view class="relative-level-label">相对强度</view>
                <view class="relative-level-value">{{currentLevelPercent}}%</view>
              </view>
              <view class="relative-level-track">
                <view class="relative-level-fill" style="width: {{currentLevelPercent}}%;"></view>
              </view>
              <view class="relative-level-warning" wx:if="{{isAtMaxLevel}}">已到测试上限，如不适请停止。</view>
            </view>

            <view class="frequency-list">
              <view
                class="frequency-item frequency-item--{{item.status}}"
                wx:for="{{frequencies}}"
                wx:key="value"
              >
                <view class="frequency-dot"></view>
                <view class="frequency-item-label">{{item.value}}</view>
              </view>
            </view>
          </view>
        </view>

        <view class="process-actions">
          <view class="auto-tone-panel auto-tone-panel--{{autoPhase}}">
            <view class="auto-tone-status">{{toneStatusText}}</view>
          </view>
          <button
            class="heard-button {{!canAnswer || currentResponse ? 'heard-button--disabled' : ''}}"
            hover-class="heard-button--pressed"
            disabled="{{!canAnswer || currentResponse}}"
            bindtap="recordHeard"
          >
            <text class="heard-button-icon" aria-hidden="true">✓</text>
            <text>{{currentResponse === 'heard' ? '已记录' : '听到了'}}</text>
          </button>
          <button
            class="retry-tone-button"
            wx:if="{{toneError}}"
            bindtap="retryAutomaticTone"
          >重新尝试</button>
          <view class="action-hint" wx:if="{{!toneError}}">第一次听到声音时点击</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="process-screen">
        <view class="process-content">
          <view class="ear-complete-card">
            <view class="complete-icon" aria-hidden="true">✓</view>
            <view class="complete-title">{{currentEarName}}完成</view>

            <view class="complete-summary">
              <view class="summary-item">
                <view class="summary-value">6 / 6</view>
                <view class="summary-label">频率</view>
              </view>
              <view class="summary-divider"></view>
              <view class="summary-item">
                <view class="summary-value">{{currentThresholdCount}}</view>
                <view class="summary-label">测得</view>
              </view>
            </view>

            <view class="complete-frequency-list">
              <view class="complete-frequency-item" wx:for="{{currentEarResults}}" wx:key="frequency">
                <view class="complete-frequency-check">{{item.detected ? '✓' : '—'}}</view>
                <view class="complete-frequency-value">{{item.frequency}} Hz</view>
                <view class="complete-threshold-value" wx:if="{{item.detected}}">{{item.thresholdPercent}}%</view>
                <view class="complete-threshold-value complete-threshold-value--missing" wx:else>未测得</view>
              </view>
            </view>
          </view>
        </view>

        <view class="process-actions">
          <button
            class="ready-button"
            hover-class="ready-button--pressed"
            wx:if="{{currentEar === 'left'}}"
            bindtap="startRightEar"
          >开始右耳测试</button>
          <button
            class="ready-button"
            hover-class="ready-button--pressed"
            wx:else
            bindtap="viewReport"
          >查看报告</button>
          <view class="action-hint">{{currentEar === 'left' ? '右耳将使用相同频率' : '结果仅供参考'}}</view>
        </view>
      </view>
    </block>
  </block>
</view>
