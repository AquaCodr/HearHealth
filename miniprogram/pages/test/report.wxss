/* 听力报告基础摘要 */
.report-page {
  background: var(--color-canvas-parchment);
}

.report-header {
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);
  text-align: center;
}

.report-kicker {
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.report-title {
  margin-top: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
}

.report-description {
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.report-content {
  padding: 0 var(--spacing-md) var(--spacing-xl);
}

.overview-card,
.chart-card,
.ear-summary-card,
.interpretation-note,
.ai-card,
.empty-state {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.overview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-md);
  text-align: center;
}

.overview-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-section);
  height: var(--spacing-section);
  border-radius: var(--radius-full);
  background: var(--color-success);
  color: var(--color-on-primary);
  font-size: var(--text-display-lg);
  font-weight: 700;
}

.overview-title {
  margin-top: var(--spacing-md);
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.overview-time {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.overview-summary {
  width: 100%;
  margin-top: var(--spacing-md);
  padding: var(--spacing-md) 0;
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.overview-value {
  color: var(--color-primary);
  font-size: var(--text-lead-airy);
  font-weight: 700;
  line-height: var(--leading-display);
}

.overview-label {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.chart-card {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
}

.chart-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.chart-title {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.chart-description {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.chart-unit {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  padding: var(--spacing-xxs) var(--spacing-xs);
  border-radius: var(--radius-pill);
  background: var(--color-surface-pearl);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.chart-legend {
  display: flex;
  align-items: center;
  margin-top: var(--spacing-md);
  gap: var(--spacing-md);
}

.legend-item {
  display: flex;
  align-items: center;
  color: var(--color-ink-muted-80);
  font-size: var(--text-fine-print);
}

.legend-dot {
  width: var(--spacing-xs);
  height: var(--spacing-xs);
  margin-right: var(--spacing-xs);
  border-radius: var(--radius-full);
}

.legend-dot--left {
  background: var(--color-primary);
}

.legend-dot--right {
  background: var(--color-success);
}

.threshold-chart {
  display: block;
  width: 100%;
  height: 440rpx;
  margin-top: var(--spacing-sm);
}

.chart-fallback {
  margin-top: var(--spacing-md);
  padding: var(--spacing-lg) var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
  text-align: center;
}

.chart-footnote {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: var(--leading-caption);
}

.ear-summary-card {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
}

.ear-summary-header {
  display: flex;
  align-items: center;
}

.ear-summary-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: var(--spacing-xxl);
  height: var(--spacing-xxl);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.ear-summary-copy {
  min-width: 0;
}

.ear-summary-title {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.ear-summary-description {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.ear-stat-row {
  display: flex;
  align-items: stretch;
  margin-top: var(--spacing-md);
  padding: var(--spacing-md) 0;
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.ear-stat-item {
  flex: 1;
  text-align: center;
}

.ear-stat-value {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.ear-stat-label {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
}

.ear-stat-divider {
  width: 2rpx;
  background: var(--color-divider-soft);
}

.threshold-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--spacing-md);
  gap: var(--spacing-xs);
}

.threshold-item {
  display: flex;
  flex: 1 1 40%;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.threshold-frequency {
  color: var(--color-ink-muted-80);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.threshold-value {
  margin-left: var(--spacing-xs);
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 700;
}

.threshold-value--missing {
  color: var(--color-ink-muted-48);
  font-weight: 500;
}

.interpretation-note {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  border-left: 8rpx solid var(--color-primary);
  background: var(--color-surface-pearl);
}

.interpretation-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.interpretation-text {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

/* AI 解读只作为原报告后的辅助信息，不改变确定性结果层级。 */
.ai-card {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
}

.ai-card-header {
  display: flex;
  align-items: center;
}

.ai-mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-sm);
  background: rgba(0, 102, 204, 0.09);
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ai-heading-copy {
  min-width: 0;
}

.ai-title,
.ai-section-title {
  color: var(--color-ink);
  font-weight: 700;
}

.ai-title {
  font-size: var(--text-body-strong);
}

.ai-subtitle {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.ai-loading,
.ai-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--spacing-md);
  padding: var(--spacing-lg) var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
  text-align: center;
}

.ai-spinner {
  box-sizing: border-box;
  width: 52rpx;
  height: 52rpx;
  margin-bottom: var(--spacing-sm);
  border: 5rpx solid rgba(0, 102, 204, 0.14);
  border-top-color: var(--color-primary);
  border-radius: var(--radius-full);
  animation: ai-spin 0.9s linear infinite;
}

@keyframes ai-spin {
  to { transform: rotate(360deg); }
}

.ai-state-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.ai-state-description {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.ai-result {
  margin-top: var(--spacing-md);
}

.ai-overview {
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: rgba(0, 102, 204, 0.06);
  color: var(--color-ink-muted-80);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.ai-section {
  margin-top: var(--spacing-md);
}

.ai-section-title {
  margin-bottom: var(--spacing-sm);
  font-size: var(--text-caption-strong);
}

.ai-list-card,
.ai-comparison-card,
.ai-note-list {
  padding: var(--spacing-sm);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.ai-list-card + .ai-list-card {
  margin-top: var(--spacing-xs);
}

.ai-item-title {
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: var(--leading-caption);
}

.ai-item-text,
.ai-caution,
.ai-note-line {
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.ai-item-text {
  margin-top: var(--spacing-xs);
}

.ai-item-text--strong {
  margin-top: 0;
  color: var(--color-ink-muted-80);
}

.ai-caution {
  margin-top: var(--spacing-xs);
  padding-top: var(--spacing-xs);
  border-top: 2rpx solid var(--color-divider-soft);
}

.ai-priority {
  display: inline-flex;
  margin-bottom: var(--spacing-xs);
  padding: 5rpx 14rpx;
  border-radius: var(--radius-pill);
  background: rgba(0, 102, 204, 0.08);
  color: var(--color-primary);
  font-size: var(--text-micro-legal);
  font-weight: 600;
}

.ai-priority--professional-check {
  background: rgba(255, 204, 0, 0.16);
  color: var(--color-ink-muted-80);
}

.ai-note-line {
  position: relative;
  padding-left: var(--spacing-sm);
}

.ai-note-line::before {
  position: absolute;
  top: 0;
  left: 0;
  color: var(--color-primary);
  content: '•';
}

.ai-note-line + .ai-note-line {
  margin-top: var(--spacing-xs);
}

.ai-note-list--attention {
  border-left: 6rpx solid var(--color-warning);
}

.ai-retry-button {
  min-width: 200rpx;
  height: 72rpx;
  margin: var(--spacing-sm) 0 0;
  padding: 0 var(--spacing-md);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-pill);
  background: var(--color-canvas);
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
  line-height: 72rpx;
}

.ai-retry-button::after {
  border: none;
}

.ai-disclaimer {
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 2rpx solid var(--color-divider-soft);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: var(--leading-caption);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(100% - (var(--spacing-md) * 2));
  margin: 0 var(--spacing-md);
  padding: var(--spacing-xl) var(--spacing-md);
  text-align: center;
}

.empty-icon {
  font-size: var(--text-display-lg);
}

.empty-title {
  margin-top: var(--spacing-md);
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.empty-description {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.report-actions {
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-xl);
}

.report-primary-button,
.report-secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  margin: 0;
  border-radius: var(--radius-pill);
  font-size: var(--text-button-large);
  font-weight: 600;
}

.report-primary-button::after,
.report-secondary-button::after {
  border: none;
}

.report-primary-button {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.report-primary-button--pressed {
  background: var(--color-primary-focus);
}

.report-secondary-button {
  margin-top: var(--spacing-sm);
  border: 2rpx solid var(--color-hairline);
  background: var(--color-canvas);
  color: var(--color-primary);
}

.report-secondary-button--pressed {
  background: var(--color-surface-pearl);
}

.report-button--disabled {
  opacity: 0.48;
}
