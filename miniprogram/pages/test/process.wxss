/* 听力测试过程页 */
.process-page {
  height: 100vh;
  min-height: 100vh;
  padding-bottom: 0;
  overflow: hidden;
  background: var(--color-canvas-parchment);
}

.progress-section {
  flex-shrink: 0;
  padding: 22rpx 34rpx 18rpx;
  background: rgba(255, 255, 255, 0.86);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.step-row {
  display: flex;
  gap: 12rpx;
  transition: gap 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 进场融合态：整条蓝条随后裂开为三段，衔接引导页的融合动画 */
.step-row--fused {
  gap: 0;
}

.step-item {
  flex: 1 1 0;
  min-width: 0;
  transition: flex-grow 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 当前步骤的分段拉长，其余分段被压缩（与引导页一致） */
.step-item--active {
  flex-grow: 2;
}

.step-row--fused .step-item {
  flex-grow: 1;
}

.step-segment {
  height: 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-hairline);
  transition: background-color 0.2s ease, border-radius 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.step-segment--active,
.step-segment--complete {
  background: var(--color-primary);
}

.step-row--fused .step-segment {
  background: var(--color-primary);
}

/* 融合态下拼接处改方角，整条呈一根完整蓝条，与引导页的融合条一致 */
.step-row--fused .step-item:first-child .step-segment {
  border-radius: 9999rpx 0 0 9999rpx;
}

.step-row--fused .step-item:nth-child(2) .step-segment {
  border-radius: 0;
}

.step-row--fused .step-item:last-child .step-segment {
  border-radius: 0 9999rpx 9999rpx 0;
}

.step-label {
  margin-top: 8rpx;
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
  text-align: center;
  transition: opacity 0.25s ease;
}

.step-row--fused .step-label {
  opacity: 0;
}

.step-label--active,
.step-label--complete {
  color: var(--color-ink);
  font-weight: 600;
}

.process-screen {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-height: 0;
  padding: 34rpx 34rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.process-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-height: 0;
}

.process-content--testing {
  justify-content: flex-start;
}

.intro-block {
  text-align: center;
}

.intro-kicker {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.intro-title,
.test-title,
.complete-title {
  color: var(--color-ink);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.12;
}

.intro-title {
  margin-top: 12rpx;
}

.intro-description {
  max-width: 560rpx;
  margin: 16rpx auto 0;
  color: var(--color-ink-muted-48);
  font-size: 28rpx;
  line-height: 1.42;
}

.setup-panel,
.frequency-card,
.ear-complete-card {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.setup-panel {
  margin-top: 42rpx;
  padding: 28rpx 30rpx;
}

.channel-row {
  display: flex;
  align-items: center;
}

.channel-item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.channel-badge,
.test-ear-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.channel-name {
  margin-left: 14rpx;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 600;
}

.channel-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--color-divider-soft);
}

.preparation-list {
  margin-top: 26rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid var(--color-divider-soft);
}

.preparation-item {
  display: flex;
  align-items: center;
  padding-top: 18rpx;
}

.preparation-check {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border-radius: var(--radius-full);
  background: #eaf4ff;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 700;
}

.preparation-text {
  flex: 1;
  color: var(--color-ink-muted-80);
  font-size: 26rpx;
  line-height: 1.34;
}

.safety-note {
  margin-top: 22rpx;
  text-align: center;
}

.safety-title {
  color: var(--color-ink-muted-48);
  font-size: 24rpx;
  line-height: 1.36;
}

.test-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.test-header-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.test-title {
  margin-top: 6rpx;
}

.tone-orb {
  position: relative;
  overflow: hidden;
  align-self: center;
  width: 276rpx;
  height: 276rpx;
  margin: 4rpx 0 24rpx;
  border-radius: var(--radius-full);
  background: rgba(240, 247, 255, 0.32);
  border: 2rpx solid rgba(28, 110, 221, 0.22);
  box-shadow:
    0 18rpx 44rpx rgba(37, 108, 213, 0.14),
    0 2rpx 4rpx rgba(255, 255, 255, 0.9) inset;
}

.tone-orb--playing,
.tone-orb--waiting {
  animation: orb-breathe 2200ms ease-in-out infinite;
}

.tone-orb--recorded {
  background: rgba(238, 253, 243, 0.65);
  border-color: rgba(52, 199, 89, 0.26);
  box-shadow:
    0 18rpx 44rpx rgba(52, 199, 89, 0.16),
    0 2rpx 4rpx rgba(255, 255, 255, 0.9) inset;
}

.tone-orb--recorded .tone-orb-fill,
.tone-orb--error .tone-orb-fill {
  opacity: 0;
}

.tone-orb--recorded .tone-orb-content {
  color: #1f9d4a;
}

.tone-orb--recorded .orb-label {
  color: #218844;
}

.tone-orb--error {
  background: rgba(255, 249, 232, 0.65);
  border-color: rgba(255, 149, 0, 0.28);
}

.tone-orb--error .tone-orb-content {
  color: #b97800;
}

.tone-orb--error .orb-label {
  color: #a66b00;
}

.tone-orb-fill {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 0;
  background: linear-gradient(180deg, #55a9ff 0%, #207eea 62%, #1467ce 100%);
  box-shadow: 0 -8rpx 20rpx rgba(68, 147, 247, 0.32);
  transition: height 780ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tone-orb-wave {
  position: absolute;
  top: -54rpx;
  left: -32%;
  width: 164%;
  height: 104rpx;
  border-radius: 43% 57% 40% 60%;
  background: rgba(225, 245, 255, 0.78);
  box-shadow: 0 8rpx 18rpx rgba(171, 219, 255, 0.42);
  animation: orb-wave 3800ms ease-in-out infinite alternate;
}

.tone-orb--playing .tone-orb-wave {
  animation-duration: 2200ms;
}

.tone-orb-content {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #0e5ebd;
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.78);
  transform: translate(-50%, -50%);
}

.tone-orb--playing .tone-orb-content,
.tone-orb--waiting .tone-orb-content {
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 62, 148, 0.24);
}

.orb-countdown,
.orb-check,
.orb-error,
.orb-idle {
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1;
}

.orb-check {
  color: #20a851;
  animation: orb-check-pop 520ms cubic-bezier(0.2, 1.4, 0.4, 1);
}

.orb-error {
  color: #bd7a00;
}

.orb-label {
  margin-top: 10rpx;
  color: inherit;
  font-size: 28rpx;
  font-weight: 700;
}

.orb-wave-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  gap: 8rpx;
}

.orb-wave-bar {
  width: 10rpx;
  height: 34rpx;
  border-radius: var(--radius-pill);
  background: currentColor;
  animation: tone-wave 700ms ease-in-out infinite alternate;
}

.orb-wave-bar--one {
  height: 26rpx;
}

.orb-wave-bar--two {
  height: 56rpx;
  animation-delay: 140ms;
}

.orb-wave-bar--three {
  height: 40rpx;
  animation-delay: 280ms;
}

.frequency-card {
  padding: 28rpx 30rpx 26rpx;
}

.frequency-header {
  text-align: center;
}

.frequency-label {
  color: var(--color-ink-muted-48);
  font-size: 24rpx;
}

.frequency-value {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.frequency-unit {
  color: var(--color-ink-muted-48);
  font-size: 28rpx;
  font-weight: 500;
}

.frequency-count {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(0, 102, 204, 0.1);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.relative-level {
  margin-top: 24rpx;
}

.relative-level-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.relative-level-label {
  color: var(--color-ink-muted-80);
  font-size: 24rpx;
  font-weight: 600;
}

.relative-level-value {
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.relative-level-track {
  overflow: hidden;
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: var(--radius-pill);
  background: #e8e8ed;
}

.relative-level-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  transition: width 200ms ease;
}

.relative-level-warning {
  margin-top: 14rpx;
  color: #9a6a00;
  font-size: 22rpx;
  line-height: 1.35;
}

.frequency-list {
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
}

.frequency-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.frequency-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: var(--radius-full);
  background: #d8d8df;
}

.frequency-item--active .frequency-dot,
.frequency-item--complete .frequency-dot {
  background: var(--color-primary);
}

.frequency-item-label {
  margin-top: 10rpx;
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
}

.frequency-item--active .frequency-item-label,
.frequency-item--complete .frequency-item-label {
  color: var(--color-ink);
  font-weight: 600;
}

.process-actions {
  flex-shrink: 0;
  padding-top: 24rpx;
  text-align: center;
}

.auto-tone-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 64rpx;
  padding: 12rpx 22rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.72);
}

.auto-tone-panel--playing {
  border-color: rgba(0, 102, 204, 0.24);
  background: #f6fbff;
}

.auto-tone-panel--recorded {
  border-color: rgba(52, 199, 89, 0.32);
}

.auto-tone-panel--error {
  border-color: rgba(255, 149, 0, 0.36);
}

@keyframes tone-wave {
  from {
    transform: scaleY(0.45);
  }
  to {
    transform: scaleY(1);
  }
}

@keyframes orb-breathe {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.025);
  }
}

@keyframes orb-wave {
  from {
    transform: translateX(-10%);
  }
  to {
    transform: translateX(10%);
  }
}

@keyframes orb-check-pop {
  0% {
    opacity: 0;
    transform: scale(0.45);
  }
  70% {
    opacity: 1;
    transform: scale(1.16);
  }
  100% {
    transform: scale(1);
  }
}

.auto-tone-status {
  flex: 1;
  min-width: 0;
  color: var(--color-ink-muted-48);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.32;
  text-align: center;
}

.ready-button,
.heard-button,
.retry-tone-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  border-radius: var(--radius-pill);
  font-weight: 600;
}

.ready-button,
.heard-button {
  height: 96rpx;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 34rpx;
}

.ready-button::after,
.heard-button::after,
.retry-tone-button::after {
  border: none;
}

.ready-button--pressed,
.heard-button--pressed {
  background: var(--color-primary-focus);
}

.heard-button {
  margin-top: 18rpx;
}

.heard-button--disabled {
  background: #e8e8ed;
  color: var(--color-ink-muted-48);
}

.heard-button-icon {
  margin-right: 10rpx;
}

.retry-tone-button {
  height: 80rpx;
  margin-top: 16rpx;
  border: 2rpx solid var(--color-primary);
  background: var(--color-canvas);
  color: var(--color-primary);
  font-size: 28rpx;
}

.action-hint {
  margin-top: 12rpx;
  color: var(--color-ink-muted-48);
  font-size: 22rpx;
}

.ear-complete-card {
  padding: 38rpx 30rpx 30rpx;
  text-align: center;
}

.complete-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-success);
  color: var(--color-on-primary);
  font-size: 38rpx;
  font-weight: 700;
}

.complete-summary {
  display: flex;
  align-items: stretch;
  margin-top: 28rpx;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: var(--color-surface-pearl);
}

.summary-item {
  flex: 1;
}

.summary-value {
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 700;
}

.summary-label {
  margin-top: 4rpx;
  color: var(--color-ink-muted-48);
  font-size: 22rpx;
}

.summary-divider {
  width: 2rpx;
  background: var(--color-divider-soft);
}

.complete-frequency-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
  gap: 12rpx;
}

.complete-frequency-item {
  display: flex;
  flex: 1 1 40%;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: var(--color-surface-pearl);
}

.complete-frequency-check {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border-radius: var(--radius-full);
  background: #eaf4ff;
  color: var(--color-primary);
  font-size: 18rpx;
  font-weight: 700;
}

.complete-frequency-value {
  flex: 1;
  color: var(--color-ink-muted-80);
  font-size: 22rpx;
  font-weight: 600;
  text-align: left;
}

.complete-threshold-value {
  margin-left: 8rpx;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.complete-threshold-value--missing {
  color: var(--color-ink-muted-48);
  font-weight: 500;
}

@media (max-height: 700px) {
  .process-screen {
    padding-top: 22rpx;
  }

  .intro-title,
  .test-title,
  .complete-title {
    font-size: 42rpx;
  }

  .frequency-value {
    font-size: 58rpx;
  }

  .tone-orb {
    width: 220rpx;
    height: 220rpx;
    margin-bottom: 22rpx;
  }

  .setup-panel {
    margin-top: 28rpx;
    padding: 24rpx;
  }

  .frequency-card,
  .ear-complete-card {
    padding-top: 26rpx;
    padding-bottom: 24rpx;
  }
}
