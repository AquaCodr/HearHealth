/* 听力测试过程页：Step 1 准备 */
.process-page {
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
  background: var(--color-canvas-parchment);
}

.progress-section {
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-sm);
  background: var(--color-canvas);
  border-bottom: 2rpx solid var(--color-divider-soft);
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.progress-count {
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.step-row {
  display: flex;
  margin-top: var(--spacing-sm);
  gap: var(--spacing-xs);
}

.step-item {
  flex: 1;
  min-width: 0;
}

.step-segment {
  height: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--color-divider-soft);
}

.step-segment--active {
  background: var(--color-primary);
}

.step-label {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  text-align: center;
}

.step-label--active {
  color: var(--color-primary);
  font-weight: 600;
}

.process-content {
  padding: var(--spacing-lg) var(--spacing-md) 0;
}

.intro-block {
  text-align: center;
}

.intro-kicker {
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.intro-title {
  margin-top: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
}

.intro-description {
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.earphone-card,
.preparation-card,
.safety-note {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.earphone-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--spacing-lg);
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);
  text-align: center;
}

.earphone-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-section);
  height: var(--spacing-section);
  border-radius: var(--radius-full);
  background: var(--color-surface-pearl);
  border: 2rpx solid var(--color-hairline);
  font-size: var(--text-display-lg);
}

.earphone-title {
  margin-top: var(--spacing-md);
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 600;
}

.earphone-description {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.channel-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-md);
  border-top: 2rpx solid var(--color-divider-soft);
}

.channel-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.channel-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-xxl);
  height: var(--spacing-xxl);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.channel-name {
  margin-top: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.channel-divider {
  width: 2rpx;
  height: var(--spacing-xl);
  background: var(--color-divider-soft);
}

.preparation-card {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
}

.section-title {
  margin-bottom: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.preparation-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 2rpx solid var(--color-divider-soft);
}

.preparation-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.preparation-check {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: var(--spacing-lg);
  height: var(--spacing-lg);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.preparation-text {
  flex: 1;
  color: var(--color-ink-muted-80);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.safety-note {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  border-left: 8rpx solid var(--color-primary);
  background: var(--color-surface-pearl);
}

.safety-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.safety-description {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.process-actions {
  padding: var(--spacing-lg) var(--spacing-md) 0;
  text-align: center;
}

.ready-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  margin: 0;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-button-large);
  font-weight: 600;
}

.ready-button::after {
  border: none;
}

.ready-button--pressed {
  background: var(--color-primary-focus);
}

.action-hint {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}
