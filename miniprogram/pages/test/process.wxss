/* 听力测试过程页：Step 1 准备 */
.process-page {
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
  background: var(--color-canvas-parchment);
}

.progress-section {
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-sm);
  background: var(--color-canvas);
  border-bottom: 2rpx solid var(--color-divider-soft);
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.progress-count {
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.step-row {
  display: flex;
  margin-top: var(--spacing-sm);
  gap: var(--spacing-xs);
}

.step-item {
  flex: 1;
  min-width: 0;
}

.step-segment {
  height: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--color-divider-soft);
}

.step-segment--active {
  background: var(--color-primary);
}

.step-segment--complete {
  background: var(--color-primary);
}

.step-label {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  text-align: center;
}

.step-label--active {
  color: var(--color-primary);
  font-weight: 600;
}

.step-label--complete {
  color: var(--color-ink-muted-80);
  font-weight: 600;
}

.process-content {
  padding: var(--spacing-lg) var(--spacing-md) 0;
}

.intro-block {
  text-align: center;
}

.intro-kicker {
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.intro-title {
  margin-top: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
}

.intro-description {
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.earphone-card,
.preparation-card,
.safety-note {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.earphone-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--spacing-lg);
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);
  text-align: center;
}

.earphone-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-section);
  height: var(--spacing-section);
  border-radius: var(--radius-full);
  background: var(--color-surface-pearl);
  border: 2rpx solid var(--color-hairline);
  font-size: var(--text-display-lg);
}

.earphone-title {
  margin-top: var(--spacing-md);
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 600;
}

.earphone-description {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.channel-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-md);
  border-top: 2rpx solid var(--color-divider-soft);
}

.channel-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.channel-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-xxl);
  height: var(--spacing-xxl);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.channel-name {
  margin-top: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.channel-divider {
  width: 2rpx;
  height: var(--spacing-xl);
  background: var(--color-divider-soft);
}

.preparation-card {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
}

.section-title {
  margin-bottom: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.preparation-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 2rpx solid var(--color-divider-soft);
}

.preparation-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.preparation-check {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: var(--spacing-lg);
  height: var(--spacing-lg);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.preparation-text {
  flex: 1;
  color: var(--color-ink-muted-80);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.safety-note {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  border-left: 8rpx solid var(--color-primary);
  background: var(--color-surface-pearl);
}

.safety-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.safety-description {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.process-actions {
  padding: var(--spacing-lg) var(--spacing-md) 0;
  text-align: center;
}

.ready-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  margin: 0;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-button-large);
  font-weight: 600;
}

.ready-button::after {
  border: none;
}

.ready-button--pressed {
  background: var(--color-primary-focus);
}

.action-hint {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

/* ========== Step 2 / 3 双耳测试 ========== */
.ear-test-card,
.frequency-card,
.tone-instruction {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.ear-test-card {
  display: flex;
  align-items: center;
  margin-top: var(--spacing-lg);
  padding: var(--spacing-md);
}

.test-ear-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: var(--spacing-xxl);
  height: var(--spacing-xxl);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.test-ear-copy {
  min-width: 0;
}

.test-ear-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.test-ear-description {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.frequency-card {
  margin-top: var(--spacing-md);
  padding: var(--spacing-lg) var(--spacing-md);
}

.frequency-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.frequency-label {
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.frequency-value {
  margin-top: var(--spacing-xs);
  color: var(--color-ink);
  font-size: var(--text-display-md);
  font-weight: 700;
  line-height: var(--leading-display);
}

.frequency-unit {
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  font-weight: 400;
}

.frequency-count {
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-pill);
  background: var(--color-surface-pearl);
  color: var(--color-ink-muted-80);
  font-size: var(--text-fine-print);
}

.relative-level {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.relative-level-header,
.relative-level-scale {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.relative-level-label {
  color: var(--color-ink-muted-80);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.relative-level-value {
  color: var(--color-primary);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.relative-level-track {
  overflow: hidden;
  height: var(--spacing-xs);
  margin-top: var(--spacing-sm);
  border-radius: var(--radius-pill);
  background: var(--color-divider-soft);
}

.relative-level-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  transition: width 200ms ease;
}

.relative-level-scale {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
}

.relative-level-note {
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: var(--leading-caption);
}

.relative-level-warning {
  margin-top: var(--spacing-sm);
  padding-left: var(--spacing-xs);
  border-left: 6rpx solid var(--color-warning);
  color: var(--color-ink-muted-80);
  font-size: var(--text-micro-legal);
  line-height: var(--leading-caption);
}

.frequency-list {
  display: flex;
  justify-content: space-between;
  margin-top: var(--spacing-lg);
}

.frequency-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.frequency-dot {
  width: var(--spacing-sm);
  height: var(--spacing-sm);
  border: 4rpx solid var(--color-divider-soft);
  border-radius: var(--radius-full);
  background: var(--color-canvas);
}

.frequency-item--active .frequency-dot {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.frequency-item-label {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
}

.frequency-item--active .frequency-item-label {
  color: var(--color-primary);
  font-weight: 600;
}

.frequency-item--complete .frequency-dot {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.frequency-item--complete .frequency-item-label {
  color: var(--color-ink-muted-80);
  font-weight: 600;
}

.tone-instruction {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-surface-pearl);
}

.tone-instruction-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.tone-instruction-text {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.auto-tone-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  padding: var(--spacing-md);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.auto-tone-panel--playing {
  border-color: rgba(0, 102, 204, 0.24);
  background: var(--color-surface-pearl);
}

.auto-tone-panel--recorded {
  border-color: rgba(52, 199, 89, 0.32);
}

.auto-tone-panel--error {
  border-color: rgba(255, 149, 0, 0.36);
}

.countdown-badge,
.auto-tone-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-section);
  height: var(--spacing-section);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-display-lg);
  font-weight: 700;
}

.auto-tone-symbol--error {
  background: var(--color-warning);
}

.sound-wave {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-section);
  height: var(--spacing-section);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  gap: 6rpx;
}

.sound-wave-bar {
  width: 6rpx;
  height: 24rpx;
  border-radius: var(--radius-pill);
  background: var(--color-on-primary);
  animation: tone-wave 600ms ease-in-out infinite alternate;
}

.sound-wave-bar--two {
  height: 40rpx;
  animation-delay: 120ms;
}

.sound-wave-bar--three {
  height: 30rpx;
  animation-delay: 240ms;
}

@keyframes tone-wave {
  from {
    transform: scaleY(0.45);
  }
  to {
    transform: scaleY(1);
  }
}

.auto-tone-status {
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-80);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: var(--leading-caption);
}

.heard-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 104rpx;
  margin: var(--spacing-md) 0 0;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-button-large);
  font-weight: 600;
}

.heard-button::after,
.retry-tone-button::after {
  border: none;
}

.heard-button--pressed {
  background: var(--color-primary-focus);
}

.heard-button--disabled {
  background: var(--color-divider-soft);
  color: var(--color-ink-muted-48);
}

.heard-button-icon {
  margin-right: var(--spacing-xs);
}

.retry-tone-button {
  width: 100%;
  height: 88rpx;
  margin: var(--spacing-sm) 0 0;
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  background: var(--color-canvas);
  color: var(--color-primary);
  font-size: var(--text-button-utility);
  font-weight: 600;
}

/* ========== 单耳 / 双耳完成 ========== */
.ear-complete-card,
.next-stage-note,
.test-complete-note {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.ear-complete-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) var(--spacing-md) var(--spacing-lg);
  text-align: center;
}

.complete-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-section);
  height: var(--spacing-section);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-display-lg);
  font-weight: 700;
}

.complete-title {
  margin-top: var(--spacing-md);
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
}

.complete-description {
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.complete-summary {
  display: flex;
  align-items: stretch;
  width: 100%;
  margin-top: var(--spacing-lg);
  padding: var(--spacing-md) 0;
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.summary-item {
  flex: 1;
}

.summary-value {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 700;
}

.summary-label {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.summary-divider {
  width: 2rpx;
  background: var(--color-divider-soft);
}

.complete-frequency-list {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  margin-top: var(--spacing-md);
  gap: var(--spacing-xs);
}

.complete-frequency-item {
  display: flex;
  flex: 1 1 40%;
  align-items: center;
  box-sizing: border-box;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-md);
  background: var(--color-surface-pearl);
}

.complete-frequency-check {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: var(--spacing-md);
  height: var(--spacing-md);
  margin-right: var(--spacing-xs);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-micro-legal);
  font-weight: 600;
}

.complete-frequency-value {
  flex: 1;
  color: var(--color-ink-muted-80);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.complete-threshold-value {
  margin-left: var(--spacing-xs);
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 700;
}

.complete-threshold-value--missing {
  color: var(--color-ink-muted-48);
  font-weight: 500;
}

.next-stage-note,
.test-complete-note {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  border-left: 8rpx solid var(--color-primary);
  background: var(--color-surface-pearl);
}

.test-complete-note {
  border-left-color: var(--color-success);
}

.next-stage-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.next-stage-description {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}
