/* 登录页样式 */
.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #e8f7ee 0%, #ffffff 60%);
  padding: 0 60rpx;
  box-sizing: border-box;
}

.logo {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #333333;
}

.app-desc {
  font-size: 26rpx;
  color: #999999;
  margin-top: 12rpx;
  margin-bottom: 100rpx;
}

.login-btn {
  width: 100%;
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 48rpx;
  padding: 20rpx 0;
}

.login-btn::after {
  border: none;
}

.login-tip {
  font-size: 24rpx;
  color: #bbbbbb;
  margin-top: 24rpx;
}
