/* 护耳技能库 页面样式 —— Apple 简约风：白底、发丝线分组列表、单一交互色 */

.skill-page {
  min-height: 100vh;
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
  background: var(--color-canvas-parchment);
}

/* 来源切换（iOS 分段控件） */
.source-switch {
  display: flex;
  margin: var(--spacing-sm) var(--spacing-md) 0;
  padding: 4rpx;
  border-radius: var(--radius-pill);
  background: #e8e8ed;
}

.source-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-pill);
  color: var(--color-ink);
  font-size: var(--text-button-utility);
  font-weight: 500;
  text-align: center;
}

.source-tab--active {
  background: var(--color-canvas);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* 分类筛选 chips（与上方分段控件同款处理：选中白底浮起，未选中透明融入底色） */
.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-list {
  display: inline-flex;
  gap: var(--spacing-xs);
  padding: var(--spacing-md) var(--spacing-md) var(--spacing-sm);
}

.chip {
  height: 60rpx;
  line-height: 60rpx;
  flex-shrink: 0;
  padding: 0 var(--spacing-md);
  border-radius: var(--radius-pill);
  background: transparent;
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  font-weight: 400;
}

.chip--selected {
  background: var(--color-canvas);
  color: var(--color-ink);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* 行级差异样式（基础 .group-list/.group-row/.row-* 见 app.wxss） */
.row-meta--stats {
  margin-top: var(--spacing-xxs);
}

/* 耳友妙招：feed 式单文本（同耳友圈广场风格，不区分标题/摘要） */
.row-text {
  color: var(--color-ink);
  font-size: var(--text-caption);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 耳友妙招行内的头像与封面 */
.post-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-full);
  background: var(--color-surface-pearl);
}

.post-cover {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  margin-left: var(--spacing-sm);
  border-radius: var(--radius-sm);
  background: var(--color-surface-pearl);
}

.list-caption {
  margin: 0 var(--spacing-md) var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
}

/* 加载 / 空状态 / 法律声明：安静的小字，不加框 */
.inline-tip {
  padding: var(--spacing-xl) 0;
  text-align: center;
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.empty-tip {
  padding: var(--spacing-xxl) var(--spacing-lg);
  text-align: center;
}

.empty-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.empty-desc {
  max-width: 520rpx;
  margin: var(--spacing-xs) auto 0;
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.legal-note {
  margin: var(--spacing-lg) var(--spacing-lg) 0;
  text-align: center;
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: 1.3;
}
