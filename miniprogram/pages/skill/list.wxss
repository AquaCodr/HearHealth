/* 护耳技能库 页面样式 */

.skill-library-page {
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
  background: var(--color-canvas-parchment);
}

.skill-library-header {
  padding-bottom: var(--spacing-md);
}

.header-kicker {
  color: var(--color-primary);
  font-size: var(--text-micro-legal);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.header-description {
  max-width: 620rpx;
  margin-top: var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.source-switch {
  display: flex;
  margin: 0 var(--spacing-md) var(--spacing-md);
  padding: 6rpx;
  border-radius: var(--radius-pill);
  background: var(--color-divider-soft);
}

.source-tab {
  flex: 1;
  padding: 18rpx var(--spacing-xs);
  border-radius: var(--radius-pill);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  font-weight: 600;
  text-align: center;
  transition: background 180ms ease, color 180ms ease;
}

.source-tab--active {
  background: var(--color-canvas);
  color: var(--color-ink);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.source-card {
  box-sizing: border-box;
  margin: 0 var(--spacing-md);
  padding: var(--spacing-md);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.source-card-header {
  display: flex;
  align-items: center;
}

.source-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: var(--spacing-xl);
  height: var(--spacing-xl);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--text-caption-strong);
  font-weight: 700;
}

.source-badge--community {
  background: var(--color-ink);
}

.source-copy {
  min-width: 0;
}

.source-title {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 600;
}

.source-description {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.source-label {
  display: inline-flex;
  margin-top: var(--spacing-md);
  padding: 10rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(0, 102, 204, 0.08);
  color: var(--color-primary);
  font-size: var(--text-micro-legal);
  font-weight: 600;
}

.source-label--community {
  background: var(--color-surface-pearl);
  color: var(--color-ink-muted-80);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--spacing-lg) var(--spacing-md) var(--spacing-sm);
}

.section-title {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 600;
}

.section-count {
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  min-height: 300rpx;
  margin: 0 var(--spacing-md);
  padding: var(--spacing-xl) var(--spacing-md);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-surface-pearl);
  text-align: center;
}

.empty-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--spacing-xl);
  height: var(--spacing-xl);
  border-radius: var(--radius-full);
  background: var(--color-canvas);
  color: var(--color-primary);
  font-size: var(--text-lead-airy);
  font-weight: 400;
}

.empty-symbol--community {
  color: var(--color-ink-muted-80);
  font-size: var(--text-caption-strong);
  letter-spacing: 3rpx;
}

.empty-title {
  margin-top: var(--spacing-md);
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.empty-description {
  max-width: 540rpx;
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.community-note {
  margin: var(--spacing-md);
  padding: var(--spacing-md);
  border-left: 8rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  background: var(--color-canvas);
}

.community-note-title {
  color: var(--color-ink);
  font-size: var(--text-fine-print);
  font-weight: 600;
}

.community-note-text {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: var(--leading-caption);
}
