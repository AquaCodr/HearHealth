<view class="container home-page">
  <!-- 顶部卡片：问候语 + 进度环（轻点后内容模糊淡出，浮现护耳小知识） -->
  <view class="top-card {{tipVisible ? 'show-tip' : ''}}" bindtap="toggleTip">
    <view class="card-front">
      <view class="top-left">
        <view class="greeting">{{greeting}}，耳友</view>
        <view class="subtitle">今天也要好好爱护耳朵哦</view>
      </view>
      <view class="top-right">
        <view class="progress-ring">
          <view class="progress-track" style="background: {{progressGradient}}">
            <view class="progress-hole"></view>
            <view class="progress-cap" style="background: {{startCapColor}}; left: {{capStartLeft}}rpx; top: {{capStartTop}}rpx;"></view>
            <view class="progress-cap" wx:if="{{progressPercent > 0 && progressPercent < 100}}" style="background: {{progressColor}}; left: {{capEndLeft}}rpx; top: {{capEndTop}}rpx;"></view>
            <view class="progress-cap" style="background: {{trackEndCapColor}}; left: {{trackCapEndLeft}}rpx; top: {{trackCapEndTop}}rpx;"></view>
          </view>
          <view class="progress-overlay">
            <view class="progress-label">今日估算</view>
            <view class="progress-value">{{todayHours}}h{{todayMinutes}}min</view>
          </view>
        </view>
      </view>
    </view>
    <view class="tip-face">
      <view class="tip-title">🌍 世界卫生组织建议</view>
      <view class="tip-item">
        <view class="tip-dot"></view>
        <text class="tip-item-text">耳机音量不超过最大音量的 <text class="tip-num">60%</text></text>
      </view>
      <view class="tip-item">
        <view class="tip-dot"></view>
        <text class="tip-item-text">单次连续佩戴不超过 <text class="tip-num">60分钟</text></text>
      </view>
      <view class="tip-item">
        <view class="tip-dot"></view>
        <text class="tip-item-text">每周使用总时长控制在 <text class="tip-num">40小时</text> 以内</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-entries">
    <view class="entry-card" bindtap="goTest">
      <view class="entry-icon">🎧</view>
      <view class="entry-title">开始听力测试</view>
    </view>
    <view class="entry-card" bindtap="goSkill">
      <view class="entry-icon">📖</view>
      <view class="entry-title">查看护耳技能库</view>
    </view>
  </view>

  <!-- 健康提示（常驻组件，不因点击消失） -->
  <view class="health-card">
    <view class="health-icon-wrap">
      <text class="health-icon">💡</text>
    </view>
    <view class="health-content">
      <view class="health-text">{{healthText}}</view>
    </view>
    <view class="health-btn" wx:if="{{!healthDismissed}}" bindtap="dismissHealth">知道了</view>
  </view>

  <!-- 近7天应用内代理记录概览 -->
  <view class="card week-card" bindtap="goStats">
    <view class="card-header">
      <view class="card-title">近7天应用内记录</view>
      <view class="card-more">查看详情 ›</view>
    </view>
    <view class="bar-chart">
      <view class="bar-item" wx:for="{{weekData}}" wx:key="day" data-index="{{index}}" catchtap="onTapBar">
        <view class="bar-wrap">
          <view class="bar-col" style="height: {{item.hours > 0 ? item.hours / maxWeekHours * 100 : 0}}%;">
            <view class="bar-tip" wx:if="{{item.selected && item.minutes > 0}}">{{item.minutes}}min</view>
            <view class="bar bar-{{item.status}}" wx:if="{{item.hours > 0}}"></view>
          </view>
        </view>
        <view class="bar-label {{item.isToday ? 'bar-label-today' : ''}}">{{item.dateLabel}}</view>
      </view>
    </view>
  </view>

  <!-- 附近医院 -->
  <view class="card hospital-card">
    <view class="card-title">附近医院</view>
    <view class="hospital-list">
      <view class="hospital-item" wx:for="{{nearbyHospitals}}" wx:key="name" data-latitude="{{item.latitude}}" data-longitude="{{item.longitude}}" data-name="{{item.name}}" data-address="{{item.address}}" bindtap="goHospital">
        <view class="hospital-info">
          <view class="hospital-name">{{item.name}}</view>
          <view class="hospital-meta">{{item.department}} · {{item.distance}}</view>
        </view>
        <view class="hospital-arrow">›</view>
      </view>
    </view>
  </view>

  <view
    class="ai-fab"
    hover-class="ai-fab--pressed"
    aria-label="打开用耳 AI 助手"
    bindtap="goAiChat"
  >AI</view>

  <view class="tabbar-placeholder"></view>
</view>
