/* 首页样式 */
.home-page {
  padding-bottom: 0;
  background: var(--color-canvas-parchment);
}

/* ========== 顶部卡片 ========== */
.top-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
  margin: 32rpx 34rpx 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.top-left {
  flex: 1;
  padding-right: 20rpx;
}

.greeting {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.25;
}

.subtitle {
  font-size: 26rpx;
  color: var(--color-ink-muted-48);
  margin-top: 12rpx;
}

.top-right {
  flex-shrink: 0;
}

/* 进度环 —— 使用 conic-gradient 替代 canvas，避免 DPR 模糊与端点抖动 */
.progress-ring {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.progress-track {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  box-sizing: border-box;
  padding: 20rpx;
}

.progress-hole {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-canvas);
}

/* 进度条两端圆角小圆点（直径=环粗，像 Apple Watch 圆环端点） */
.progress-cap {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.progress-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 100%;
}

.progress-label {
  font-size: 22rpx;
  color: var(--color-ink-muted-48);
  margin-bottom: 4rpx;
}

.progress-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink);
}

/* ========== 快捷入口 ========== */
.quick-entries {
  display: flex;
  gap: 24rpx;
  padding: 0 34rpx 28rpx;
}

.entry-card {
  flex: 1;
  background: var(--color-canvas);
  border-radius: var(--radius-md);
  border: 3rpx solid var(--color-primary);
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.entry-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
  text-align: center;
}

/* ========== 健康提示 ========== */
.health-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff8e6, #ffefcc);
  border-radius: var(--radius-md);
  margin: 0 34rpx 28rpx;
  padding: 28rpx 24rpx;
}

.health-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffcc00;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.health-icon {
  font-size: 36rpx;
}

.health-content {
  flex: 1;
  min-width: 0;
}

.health-text {
  font-size: 26rpx;
  color: var(--color-ink-muted-80);
  line-height: 1.4;
}

.health-btn {
  flex-shrink: 0;
  background: var(--color-canvas);
  color: var(--color-ink-muted-80);
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-pill);
  margin-left: 16rpx;
}

/* ========== 通用卡片 ========== */
.card {
  background: var(--color-canvas);
  border-radius: var(--radius-md);
  margin: 0 34rpx 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-header .card-title {
  margin-bottom: 0;
}

.card-more {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* ========== 本周柱状图 ========== */
.bar-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 300rpx;
  padding-top: 16rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 40rpx;
  border-radius: 10rpx 10rpx 0 0;
  min-height: 8rpx;
}

.bar-normal {
  background: linear-gradient(180deg, #4d94ff, #0066cc);
}

.bar-warning {
  background: linear-gradient(180deg, #ffb347, #ff9500);
}

.bar-danger {
  background: linear-gradient(180deg, #ff6b6b, #ff3b30);
}

.bar-label {
  font-size: 22rpx;
  color: var(--color-ink-muted-48);
  margin-top: 14rpx;
}

/* ========== 附近医院 ========== */
.hospital-list {
  margin-top: -8rpx;
}

.hospital-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-divider-soft);
}

.hospital-item:last-child {
  border-bottom: none;
}

.hospital-info {
  flex: 1;
  min-width: 0;
}

.hospital-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-meta {
  font-size: 24rpx;
  color: var(--color-ink-muted-48);
  margin-top: 6rpx;
}

.hospital-arrow {
  font-size: 36rpx;
  color: var(--color-ink-muted-48);
  margin-left: 16rpx;
}
