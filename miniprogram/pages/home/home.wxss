/* 首页样式 */
.home-page {
  padding-bottom: 0;
  background: var(--color-canvas-parchment);
}

/* ========== 顶部卡片 ========== */
.top-card {
  position: relative;
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
  margin: 32rpx 34rpx 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 卡片正面：问候语 + 进度环，点击后模糊淡出 */
.card-front {
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: filter 0.35s ease, opacity 0.35s ease;
}

.show-tip .card-front {
  filter: blur(6px);
  -webkit-filter: blur(6px);
  opacity: 0;
  pointer-events: none;
}

/* 卡片背面：护耳小知识，待正面淡出后再淡入 */
.tip-face {
  position: absolute;
  top: 50%;
  left: 40rpx;
  right: 40rpx;
  transform: translateY(-50%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.show-tip .tip-face {
  opacity: 1;
  transition-delay: 0.25s;
}

.top-left {
  flex: 1;
  padding-right: 20rpx;
}

.greeting {
  font-size: var(--text-lead);
  font-weight: 700;
  color: var(--color-ink);
  line-height: var(--leading-display);
}

.subtitle {
  font-size: var(--text-caption);
  color: var(--color-ink-muted-48);
  margin-top: 12rpx;
}

/* 护耳小知识（背面层）：标题 + 三条要点 */
.tip-title {
  font-size: var(--text-fine-print);
  color: var(--color-ink-muted-48);
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: var(--text-caption);
  line-height: var(--leading-body);
  color: var(--color-ink);
}

.tip-item:first-of-type {
  margin-top: 0;
}

.tip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-num {
  color: var(--color-primary);
  font-weight: 700;
}

.top-right {
  flex-shrink: 0;
}

/* 进度环 —— 使用 conic-gradient 替代 canvas，避免 DPR 模糊与端点抖动 */
.progress-ring {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.progress-track {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  box-sizing: border-box;
  padding: 20rpx;
}

.progress-hole {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-canvas);
}

/* 进度条两端圆角小圆点（直径=环粗，像 Apple Watch 圆环端点） */
.progress-cap {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.progress-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 100%;
}

.progress-label {
  font-size: var(--text-fine-print);
  color: var(--color-ink-muted-48);
  margin-bottom: 4rpx;
}

.progress-value {
  font-size: var(--text-body);
  font-weight: 700;
  color: var(--color-ink);
}

/* ========== 快捷入口 ========== */
.quick-entries {
  display: flex;
  gap: 24rpx;
  padding: 0 34rpx 28rpx;
}

.entry-card {
  flex: 1;
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-divider-soft);
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.entry-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.entry-title {
  font-size: var(--text-body);
  font-weight: 600;
  color: var(--color-ink);
  text-align: center;
}

/* ========== 健康提示 ========== */
.health-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff8e6, #ffefcc);
  border-radius: var(--radius-lg);
  margin: 0 34rpx 28rpx;
  padding: 28rpx 24rpx;
}

.health-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-warning);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.health-icon {
  font-size: 36rpx;
}

.health-content {
  flex: 1;
  min-width: 0;
}

.health-text {
  font-size: var(--text-caption);
  color: var(--color-ink-muted-80);
  line-height: var(--leading-caption);
}

.health-btn {
  flex-shrink: 0;
  background: var(--color-canvas);
  color: var(--color-ink-muted-80);
  font-size: var(--text-button-utility);
  font-weight: 500;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-pill);
  margin-left: 16rpx;
}

/* ========== 通用卡片 ========== */
.card {
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
  margin: 0 34rpx 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: var(--text-body-strong);
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-header .card-title {
  margin-bottom: 0;
}

.card-more {
  font-size: var(--text-caption);
  color: var(--color-primary);
}

/* ========== 本周柱状图 ========== */
.bar-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 300rpx;
  padding-top: 16rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar-col {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  min-height: 0;
}

.bar-tip {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  color: var(--color-ink);
  font-size: var(--text-micro-legal);
  font-weight: 500;
  line-height: 1;
  padding: 4rpx 0;
  white-space: nowrap;
  z-index: 2;
}

.bar {
  width: 40rpx;
  height: 100%;
  border-radius: 10rpx 10rpx 0 0;
}

.bar-normal {
  background: linear-gradient(180deg, #5cd97a, var(--color-success));
}

.bar-warning {
  background: linear-gradient(180deg, #ffdd4d, var(--color-warning));
}

.bar-danger {
  background: linear-gradient(180deg, #ff6b6b, var(--color-danger));
}

.bar-label {
  font-size: var(--text-fine-print);
  color: var(--color-ink-muted-48);
  margin-top: 14rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.bar-label-today {
  color: var(--color-primary);
  font-weight: 600;
}

/* ========== 附近医院 ========== */
.hospital-list {
  margin-top: -8rpx;
}

.hospital-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-divider-soft);
}

.hospital-item:last-child {
  border-bottom: none;
}

.hospital-info {
  flex: 1;
  min-width: 0;
}

.hospital-name {
  font-size: var(--text-body);
  font-weight: 500;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-meta {
  font-size: var(--text-fine-print);
  color: var(--color-ink-muted-48);
  margin-top: 6rpx;
}

.hospital-arrow {
  font-size: 36rpx;
  color: var(--color-ink-muted-48);
  margin-left: 16rpx;
}
