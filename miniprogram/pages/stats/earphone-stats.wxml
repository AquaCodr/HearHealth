<sound-detail
  range-options="{{rangeOptions}}"
  selected-range="{{selectedRange}}"
  status-label="暴露状态"
  status-text="状态良好"
  date-range="{{dateRange}}"
  chart-bars="{{chartBars}}"
  x-labels="{{xLabels}}"
  metrics="{{metrics}}"
  reference-value="{{60}}"
  info-title="耳机音量说明"
  info-text="暴露量结合耳机音量与使用时间估算。当前数据为界面演示数据，正式健康阈值需由专业规则确认。"
  footer-text="声音暴露数据仅供趋势参考，不能替代专业听力检查。"
  bind:rangechange="onRangeChange"
/>
