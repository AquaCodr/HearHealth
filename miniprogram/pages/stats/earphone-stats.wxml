<sound-detail
  range-options="{{rangeOptions}}"
  selected-range="{{selectedRange}}"
  status-label="暴露状态"
  status-text="{{statusText}}"
  date-range="{{dateRange}}"
  chart-bars="{{chartBars}}"
  x-labels="{{xLabels}}"
  metrics="{{metrics}}"
  reference-value="{{60}}"
  info-title="耳机音量说明"
  info-text="当前时长来自小程序前台代理记录，音量采样为演示数据，不代表真实耳机测量。正式健康阈值需由专业规则确认。"
  footer-text="声音暴露数据仅供趋势参考，不能替代专业听力检查。"
  bind:rangechange="onRangeChange"
/>
