<sound-detail
  range-options="{{rangeOptions}}"
  selected-range="{{selectedRange}}"
  status-label="环境暴露"
  status-text="{{statusText}}"
  date-range="{{dateRange}}"
  chart-bars="{{chartBars}}"
  x-labels="{{xLabels}}"
  metrics="{{metrics}}"
  reference-value="{{60}}"
  info-title="环境音量说明"
  info-text="环境音量为应用内采样的趋势估计，不用于判断具体疾病或听力损伤。"
  footer-text="环境音量会受使用环境影响，数据仅供趋势参考。"
  bind:rangechange="onRangeChange"
/>
