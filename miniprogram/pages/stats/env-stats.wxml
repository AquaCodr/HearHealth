<sound-detail
  range-options="{{rangeOptions}}"
  selected-range="{{selectedRange}}"
  status-label="环境暴露"
  status-text="状态良好"
  date-range="{{dateRange}}"
  chart-bars="{{chartBars}}"
  x-labels="{{xLabels}}"
  metrics="{{metrics}}"
  reference-value="{{60}}"
  info-title="环境音量说明"
  info-text="环境音量由设备麦克风采集并汇总为趋势。当前数据为界面演示数据，不用于判断具体疾病或听力损伤。"
  footer-text="环境音量会受到设备位置与采集条件影响，数据仅供趋势参考。"
  bind:rangechange="onRangeChange"
/>
