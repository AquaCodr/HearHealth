/* 个人中心 */
.profile-page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--spacing-sm) var(--spacing-md)
    calc(100rpx + env(safe-area-inset-bottom) + var(--spacing-lg));
  background: var(--color-canvas-parchment);
}

.profile-content {
  width: 100%;
}

.profile-title {
  color: var(--color-ink);
  font-size: var(--text-display-md);
  font-weight: 700;
  line-height: var(--leading-display);
  margin-bottom: var(--spacing-sm);
}

.user-summary {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 260rpx;
  padding: var(--spacing-lg) var(--spacing-sm);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.user-summary--pressed {
  background: var(--color-surface-pearl);
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--color-hairline);
  background: var(--color-canvas);
  border-radius: var(--radius-full);
  box-sizing: border-box;
}

.user-copy {
  flex: 1;
  min-width: 0;
  margin-left: var(--spacing-sm);
}

.user-nickname {
  color: var(--color-ink);
  font-size: var(--text-tagline);
  font-weight: 600;
  line-height: 1.2;
}

.user-bio {
  overflow: hidden;
  color: var(--color-ink-muted-48);
  font-size: var(--text-body);
  line-height: 1.35;
  margin-top: var(--spacing-xxs);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-device {
  overflow: hidden;
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-80);
  font-size: var(--text-body-strong);
  font-weight: 500;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-summary-chevron {
  width: 18rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  opacity: 0.4;
}

.stats-card {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  min-height: 216rpx;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm) 0;
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.stat-item {
  position: relative;
  display: flex;
  flex: 1 1 0;
  width: 33.333%;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xs);
  box-sizing: border-box;
}

.stat-item--divided::after {
  position: absolute;
  top: var(--spacing-md);
  right: 0;
  bottom: var(--spacing-md);
  width: 2rpx;
  background: var(--color-hairline);
  opacity: 0.42;
  content: "";
}

.stat-value {
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
}

.stat-label {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
  white-space: nowrap;
}

.profile-actions {
  margin-top: var(--spacing-sm);
}

.menu-group + .menu-group {
  margin-top: 20rpx;
}

.menu-group {
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--color-divider-soft);
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
}

.menu-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: var(--spacing-xs) var(--spacing-sm);
  box-sizing: border-box;
}

.menu-row--pressed {
  background: var(--color-surface-pearl);
}

.menu-row--divided::after {
  position: absolute;
  right: var(--spacing-sm);
  bottom: 0;
  left: calc(var(--spacing-sm) + 76rpx + var(--spacing-sm));
  height: 2rpx;
  background: var(--color-hairline);
  opacity: 0.55;
  content: "";
}

.menu-icon-box {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  margin-right: var(--spacing-sm);
}

.menu-icon-box--my-posts {
  background: rgba(0, 102, 204, 0.07);
}

.menu-icon-box--skill-library {
  background: rgba(0, 102, 204, 0.055);
}

.menu-icon-box--settings {
  background: rgba(0, 102, 204, 0.045);
}

.menu-icon-box--about {
  background: rgba(122, 122, 122, 0.08);
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.menu-title {
  flex: 1;
  min-width: 0;
  color: var(--color-ink);
  font-size: var(--text-button-large);
  font-weight: 500;
  line-height: var(--leading-body);
  margin-right: var(--spacing-sm);
}

.menu-chevron {
  width: 18rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: auto;
  opacity: 0.4;
}
