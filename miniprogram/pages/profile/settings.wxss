.settings-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--spacing-sm) var(--spacing-md)
    calc(var(--spacing-lg) + env(safe-area-inset-bottom));
  background: var(--color-canvas-parchment);
}

.settings-title {
  margin-bottom: var(--spacing-lg);
  color: var(--color-ink);
  font-size: var(--text-display-md);
  font-weight: 700;
  line-height: var(--leading-display);
}

.settings-section + .settings-section {
  margin-top: var(--spacing-lg);
}

.section-title {
  margin: 0 0 var(--spacing-xs) var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  font-weight: 600;
  line-height: var(--leading-caption);
}

.grouped-card {
  overflow: hidden;
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.settings-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 112rpx;
  padding: var(--spacing-xs) var(--spacing-sm);
}

.settings-row--pressed {
  background: var(--color-surface-pearl);
}

.settings-row--divided::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: var(--spacing-sm);
  height: 2rpx;
  background: var(--color-hairline);
  opacity: 0.48;
  content: "";
}

.settings-row--stacked {
  align-items: center;
}

.row-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.row-hint {
  margin-top: 6rpx;
  color: var(--color-ink-muted-80);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.row-label,
.danger-label {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 500;
  line-height: var(--leading-body);
}

.row-trailing {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-left: var(--spacing-md);
}

.row-value {
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
}

.row-chevron {
  width: 16rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-left: var(--spacing-xs);
  opacity: 0.45;
}

.settings-switch {
  flex-shrink: 0;
  margin-left: var(--spacing-md);
  transform: scale(0.86);
  transform-origin: right center;
}

.danger-label {
  color: var(--color-danger);
}

.settings-version {
  margin-top: auto;
  padding-top: var(--spacing-xl);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: var(--leading-caption);
  text-align: center;
}
