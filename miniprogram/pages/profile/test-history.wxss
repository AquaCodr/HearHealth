/* 测试历史 页面样式 */
.test-history {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.page-header {
  padding: 16rpx 8rpx 24rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.loading-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background: #0066cc;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.record-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.record-card--pressed {
  background: #f2f2f2;
}

.record-time-box {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  margin-right: 28rpx;
}

.record-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.record-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.record-ears {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ear-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 1.6;
}

.ear-name {
  flex-shrink: 0;
  width: 72rpx;
  color: #888;
}

.ear-value {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-chevron {
  width: 18rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  opacity: 0.4;
}
