.points-shop-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--spacing-md) var(--spacing-md)
    calc(var(--spacing-xl) + env(safe-area-inset-bottom));
  background: var(--color-canvas-parchment);
}

.shop-header {
  padding: var(--spacing-sm) 0 var(--spacing-md);
}

.shop-kicker {
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.shop-title {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
}

.shop-description {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.balance-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 250rpx;
  padding: var(--spacing-lg);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.balance-copy {
  flex: 1;
  min-width: 0;
}

.balance-label {
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

.balance-value {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink);
  font-size: var(--text-display-lg);
  font-weight: 700;
  line-height: var(--leading-display);
}

.balance-caption {
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.balance-caption--error {
  color: var(--color-danger);
}

.balance-medal {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-left: var(--spacing-md);
  border: 2rpx solid rgba(0, 102, 204, 0.18);
  border-radius: var(--radius-full);
  background: rgba(0, 102, 204, 0.07);
}

.balance-medal-star {
  color: var(--color-primary);
  font-size: var(--text-lead);
  line-height: 1;
}

.shop-section {
  margin-top: var(--spacing-sm);
  padding: var(--spacing-md);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.ledger-section {
  padding-bottom: var(--spacing-sm);
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.section-title {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 600;
  line-height: 1.3;
}

.section-description {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.section-count {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface-pearl);
  color: var(--color-ink-muted-80);
  font-size: var(--text-fine-print);
  line-height: 1.3;
}

.category-list {
  margin-top: var(--spacing-sm);
}

.ledger-state {
  padding: var(--spacing-md) 0 var(--spacing-xs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
  text-align: center;
}

.ledger-state--error {
  color: var(--color-danger);
}

.retry-button {
  display: flex;
  width: 180rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: var(--spacing-sm) auto 0;
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  background: var(--color-canvas);
  color: var(--color-primary);
  font-size: var(--text-fine-print);
  font-weight: 600;
  line-height: 1;
}

.retry-button::after {
  border: none;
}

.ledger-list {
  margin-top: var(--spacing-sm);
}

.ledger-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: var(--spacing-xs) 0;
  border-top: 2rpx solid var(--color-divider-soft);
}

.ledger-copy {
  flex: 1;
  min-width: 0;
}

.ledger-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-time {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.ledger-points {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  color: var(--color-ink-muted-80);
  font-size: var(--text-body-strong);
  font-weight: 600;
  line-height: 1.3;
}

.ledger-points--credit {
  color: var(--color-primary);
}

.category-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: var(--spacing-xs) 0;
  border-top: 2rpx solid var(--color-divider-soft);
}

.category-mark {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: rgba(0, 102, 204, 0.07);
  color: var(--color-primary);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.category-mark--souvenirs {
  background: var(--color-surface-pearl);
  color: var(--color-ink-muted-80);
}

.category-copy {
  flex: 1;
  min-width: 0;
  margin-left: var(--spacing-sm);
}

.category-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
  line-height: 1.3;
}

.category-description {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.empty-card {
  margin-top: var(--spacing-sm);
  padding: var(--spacing-lg) var(--spacing-md);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
  text-align: center;
}

.empty-symbol {
  color: var(--color-primary);
  font-size: var(--text-lead);
  line-height: 1;
}

.empty-title {
  margin-top: var(--spacing-sm);
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 600;
  line-height: 1.3;
}

.empty-description {
  max-width: 560rpx;
  margin: var(--spacing-xs) auto 0;
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
}

/* 游客登录引导 */
.login-gate {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) var(--spacing-md);
  text-align: center;
}

.login-gate-symbol {
  color: var(--color-ink-muted-48);
  font-size: 64rpx;
  line-height: 1;
}

.login-gate-title {
  margin-top: var(--spacing-sm);
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 600;
}

.login-gate-description {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.login-gate-button {
  width: 320rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--spacing-md);
  border-radius: var(--radius-pill);
  background: linear-gradient(180deg, #2b8cff 0%, #0066cc 100%);
  color: #ffffff;
  font-size: var(--text-body-strong);
  font-weight: 600;
  line-height: 1;
}

.shop-note {
  padding: var(--spacing-md) var(--spacing-sm) 0;
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: var(--leading-caption);
  text-align: center;
}
