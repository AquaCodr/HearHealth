<view class="splash-page">
  <view class="splash-brand">
    <image class="splash-logo" src="/images/icons/headphones.svg" mode="aspectFit"></image>
    <view class="splash-name">HearHealth</view>
    <view class="splash-slogan">关注听力健康，从每天开始</view>
  </view>

  <view class="splash-actions">
    <button
      class="splash-login-btn {{loggingIn ? 'splash-login-btn--loading' : ''}}"
      bindtap="onLoginTap"
      hover-class="splash-login-btn--pressed"
      disabled="{{loggingIn}}"
    >{{loggingIn ? '正在登录…' : '微信一键登录'}}</button>
    <view class="splash-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
    <view class="splash-skip" bindtap="onSkipTap" hover-class="splash-skip--pressed">暂不登录，先逛逛</view>
  </view>
</view>
