/* 开屏页 —— 方案A：声波涟漪·科技感（品牌蓝渐变） */

.splash-page {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 300rpx var(--spacing-lg) calc(env(safe-area-inset-bottom) + 120rpx);
  overflow: hidden;
}

/* 背景渐变：深品牌蓝 → 品牌蓝（与全 App 主色同族，避免藏蓝割裂） */
.splash-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #0E3A75 0%, #15559B 46%, #0066cc 100%);
}

/* 光晕层：增加层次感 */
.splash-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.splash-glow--top {
  top: -180rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 760rpx;
  height: 760rpx;
  background: radial-gradient(circle, rgba(41, 151, 255, 0.28) 0%, rgba(41, 151, 255, 0) 70%);
}

.splash-glow--bottom {
  bottom: -240rpx;
  right: -160rpx;
  width: 700rpx;
  height: 700rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
}

/* ===== 声波涟漪层 =====
   涟漪容器是 logo-wrap（260rpx）的定位锚点：
   通过负 margin 让 560rpx 圆环的圆心与耳机圆环圆心重合 */
.splash-ripple {
  position: absolute;
  top: 130rpx;            /* logo-wrap 高度一半 */
  left: 50%;
  width: 560rpx;
  height: 560rpx;
  margin-left: -280rpx;   /* 水平居中 */
  margin-top: -280rpx;    /* 垂直对齐圆心 */
  pointer-events: none;
  z-index: 0;
}

.ripple-circle {
  position: absolute;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(41, 151, 255, 0.65);
  opacity: 0;
  animation: ripple-out 4.5s cubic-bezier(0.1, 0.6, 0.4, 1) infinite;
  box-shadow: 0 0 20rpx rgba(41, 151, 255, 0.25);
}

.ripple-1 { animation-delay: 0s; }
.ripple-2 { animation-delay: 0.9s; }
.ripple-3 { animation-delay: 1.8s; }
.ripple-4 { animation-delay: 2.7s; }
.ripple-5 { animation-delay: 3.6s; }

@keyframes ripple-out {
  0% {
    transform: scale(0.4);
    opacity: 0.8;
  }
  80% {
    opacity: 0.12;
  }
  100% {
    transform: scale(1.3);
    opacity: 0;
  }
}

/* ===== 品牌区 ===== */
.splash-brand {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 220rpx;
  animation: fade-up 0.7s ease-out both;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.splash-logo-wrap {
  position: relative;
  z-index: 1;
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 52rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.26) 0%, rgba(255, 255, 255, 0.10) 70%);
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  box-shadow:
    0 24rpx 80rpx rgba(0, 0, 0, 0.28),
    inset 0 0 56rpx rgba(255, 255, 255, 0.12),
    0 0 60rpx rgba(41, 151, 255, 0.45);
}

.splash-logo {
  width: 180rpx;
  height: 180rpx;
}

.splash-name {
  color: #ffffff;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.1;
  text-shadow: 0 4rpx 30rpx rgba(0, 0, 0, 0.35);
}

.splash-divider {
  width: 140rpx;
  height: 6rpx;
  margin-top: 36rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, rgba(124, 192, 255, 0), #9ad0ff 35%, #ffffff 50%, #9ad0ff 65%, rgba(124, 192, 255, 0));
  box-shadow:
    0 0 20rpx rgba(124, 192, 255, 0.8),
    0 0 40rpx rgba(124, 192, 255, 0.4);
}

.splash-slogan {
  margin-top: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: var(--text-body);
  letter-spacing: 3rpx;
  line-height: 1.5;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.25);
}

/* ===== 操作区 ===== */
.splash-actions {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  animation: fade-up 0.7s ease-out 0.35s both;
}

/* 品牌蓝实心发光按钮 */
.splash-hint {
  margin-bottom: var(--spacing-md);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: 1.4;
  text-align: center;
}

.splash-login-btn {
  width: 100%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: linear-gradient(180deg, #2b8cff 0%, #0066cc 100%);
  color: #ffffff;
  font-size: var(--text-button-large);
  font-weight: 600;
  line-height: 1;
  border: none;
  box-shadow:
    0 16rpx 48rpx rgba(0, 102, 204, 0.45),
    0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.splash-login-btn--pressed {
  background: linear-gradient(180deg, #1a7ae8 0%, #005bb8 100%);
  transform: scale(0.98);
}

.splash-login-btn--loading {
  opacity: 0.75;
}

/* 协议勾选：默认未勾选，勾选后才允许登录建档 */
.splash-agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--spacing-md);
  padding: var(--spacing-xxs) var(--spacing-sm);
}

.splash-checkbox {
  position: relative;
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 50%;
  box-sizing: border-box;
}

.splash-checkbox--checked {
  border-color: #ffffff;
  background: #ffffff;
}

.splash-checkbox--checked::after {
  position: absolute;
  top: 5rpx;
  left: 9rpx;
  width: 8rpx;
  height: 15rpx;
  border-right: 3rpx solid #0066cc;
  border-bottom: 3rpx solid #0066cc;
  transform: rotate(40deg);
  content: "";
}

.splash-agreement-text {
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.splash-link {
  color: rgba(255, 255, 255, 0.95);
  text-decoration: underline;
}

.splash-error {
  margin-top: var(--spacing-sm);
  padding: var(--spacing-xxs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  background: rgba(255, 59, 48, 0.18);
  color: #ffd9d4;
  font-size: var(--text-caption);
  line-height: 1.4;
  text-align: center;
}

.splash-skip {
  margin-top: var(--spacing-md);
  padding: var(--spacing-xxs) var(--spacing-md);
  color: rgba(255, 255, 255, 0.7);
  font-size: var(--text-body);
  line-height: 1.5;
}

.splash-skip--pressed {
  color: rgba(255, 255, 255, 0.9);
}

/* 已登录用户的进入提示 */
.splash-entering {
  color: rgba(255, 255, 255, 0.75);
  font-size: var(--text-body);
  letter-spacing: 2rpx;
}
