/* 耳友圈广场 —— 设计 token 参考 DesignTemplate/apple-variables.css
   主色 #0066cc，canvas 白底扁平信息流，1px≈2rpx */

.community-page {
  min-height: 100vh;
  background: #ffffff;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

/* 分区导航栏（无圆圈包裹，选中态：主色+加粗+放大，遵循 DesignTemplate 不滥用阴影） */
.tab-bar {
  white-space: nowrap;
  padding: 24rpx 24rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.tab-list {
  position: relative;
  display: inline-flex;
  align-items: flex-end;
  padding-bottom: 14rpx;
}

.tab-item {
  position: relative;
  flex: none;
  min-width: 96rpx;
  padding: 12rpx 16rpx;
  margin-right: 16rpx;
  text-align: center;
  color: #7a7a7a;
}

.tab-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 400;
  color: inherit;
  transition: font-size 0.3s ease, font-weight 0.3s ease, color 0.3s ease;
}

.tab-item--active {
  color: #0066cc;
}

.tab-item--active .tab-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #0066cc;
}

/* 滑动下划线指示器（贴文字底部，宽度=文字实际宽度） */
.tab-indicator {
  position: absolute;
  bottom: 0;
  height: 6rpx;
  border-radius: 9999px;
  background: #0066cc;
  transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 帖子流：参考 Twitter 扁平样式——头像在左、正文在右，
   头像纵向居于正文块中段，板块标签放到统计行末尾，整体只有一种主字号 */
.post-list {
  padding: 0 32rpx;
}

.post-item {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.post-item:last-child {
  border-bottom: none;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999px;
  background: #f0f0f0;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.post-body {
  flex: 1;
  min-width: 0;
}

/* 头部一行：昵称 + · + 时间 + · + 设备，单行截断 */
.post-head {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 1.3;
  color: #7a7a7a;
  flex-wrap: wrap;
}

.post-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-right: 8rpx;
}

.post-head-sep {
  color: #d2d2d7;
  margin: 0 8rpx;
}

.post-time,
.post-device {
  color: #7a7a7a;
}

/* 正文：唯一主字号，短帖原样、长帖最多 6 行截断 */
.post-content {
  font-size: 30rpx;
  color: #1d1d1f;
  line-height: 1.5;
  margin-top: 10rpx;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

/* 封面：宽度撑满、高度随图片比例自适应 */
.post-thumb {
  margin-top: 16rpx;
  width: 100%;
  border-radius: 11rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.post-thumb-img {
  width: 100%;
  display: block;
}

/* 底部互动行：图标统计 + 板块标签右对齐 */
.post-stats {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #7a7a7a;
  margin-right: 28rpx;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

/* 板块标签：去掉背景色块，作为细分隔的小字 */
.post-tag-inline {
  margin-left: auto;
  font-size: 22rpx;
  color: #0066cc;
  font-weight: 500;
}

/* 空状态 */
.empty-tip {
  margin-top: 120rpx;
  text-align: center;
  color: #7a7a7a;
  font-size: 28rpx;
}

/* 悬浮发帖按钮 */
.post-fab {
  position: fixed;
  right: 48rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999px;
  background: #0066cc;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 102, 204, 0.4);
}
