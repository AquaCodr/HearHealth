/* 发帖编辑页 —— 参考小红书简洁留白风格 */

.publish-page {
  min-height: 100vh;
  background: #ffffff;
  box-sizing: border-box;
  padding: 24rpx 32rpx 200rpx;
}

/* 进入幕布：从耳友圈位置展开的蓝色转场层 */
.curtain-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  pointer-events: none;
  transition: opacity 0.36s ease;
}

.curtain-fill {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: #0066cc;
  transition: clip-path 0.42s cubic-bezier(0.22, 1, 0.36, 1), -webkit-clip-path 0.42s cubic-bezier(0.22, 1, 0.36, 1);
}

/* 底部操作栏：固定在底部，取消 + 发布大号加长 */
.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.action-cancel {
  flex: 0 0 auto;
  font-size: 32rpx;
  font-weight: 500;
  color: #1d1d1f;
  background: #f2f2f7;
  border-radius: 9999rpx;
  padding: 28rpx 44rpx;
  text-align: center;
}

.action-publish {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #0066cc;
  border-radius: 9999rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 102, 204, 0.28);
}

.action-publish--disabled {
  background: #e8e8ed;
  color: #b0b0b5;
  box-shadow: none;
}

/* 编辑器区域 */
.editor {
  margin-top: 8rpx;
}

.report-prefill-note {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #0066cc;
  border-radius: 18rpx;
  background: #fafafc;
}

.report-prefill-title {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 600;
}

.report-prefill-description {
  margin-top: 8rpx;
  color: #7a7a7a;
  font-size: 24rpx;
  line-height: 1.43;
}

.content-input {
  width: 100%;
  min-height: 420rpx;
  font-size: 30rpx;
  color: #1d1d1f;
  line-height: 1.7;
  padding: 8rpx 0 24rpx;
  caret-color: #0066cc;
  box-sizing: border-box;
}

/* 图片横向滚动区 */
.media-section {
  margin-top: 8rpx;
}

.image-scroll {
  width: 100%;
  white-space: nowrap;
}

.image-scroll__content {
  display: inline-flex;
  align-items: center;
  padding-right: 32rpx;
}

.image-item {
  position: relative;
  flex-shrink: 0;
  width: 220rpx;
  height: 220rpx;
  margin-right: 16rpx;
}

.image-thumb {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f5f5f7;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 9999px;
  background: rgba(29, 29, 31, 0.6);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
}

.image-add {
  flex-shrink: 0;
  width: 220rpx;
  height: 220rpx;
  background: #f5f5f7;
  border: 2rpx dashed #d2d2d7;
  border-radius: 16rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.image-add-icon {
  font-size: 48rpx;
  color: #7a7a7a;
  line-height: 1;
}

.image-add-text {
  font-size: 22rpx;
  color: #7a7a7a;
  margin-top: 12rpx;
}

/* 板块选择 */
.topic-section {
  margin-top: 40rpx;
}

.section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #8e8e93;
  margin-bottom: 20rpx;
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
}

.topic-chip {
  font-size: 26rpx;
  color: #1d1d1f;
  background: #f5f5f7;
  border: 1rpx solid #f5f5f7;
  border-radius: 9999rpx;
  padding: 16rpx 32rpx;
  margin: 0 16rpx 16rpx 0;
  transition: all 0.2s ease;
}

.topic-chip--active {
  color: #0066cc;
  background: rgba(0, 102, 204, 0.08);
  border-color: rgba(0, 102, 204, 0.25);
  font-weight: 600;
}

/* 底部辅助信息 */
.footer-hint {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 40rpx;
}

.word-count {
  font-size: 22rpx;
  color: #b0b0b0;
}
