/* 发帖编辑页 —— 设计 token 参考 DesignTemplate/apple-variables.css（1px≈2rpx） */

.publish-page {
  min-height: 100vh;
  background: #f5f5f7;
  box-sizing: border-box;
  padding: 24rpx;
}

/* 顶部操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}

.action-cancel {
  font-size: 30rpx;
  color: #7a7a7a;
  padding: 12rpx 8rpx;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.action-publish {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: #0066cc;
  border-radius: 9999px;
  padding: 12rpx 36rpx;
}

.action-publish--disabled {
  opacity: 0.5;
}

/* 板块选择 */
.section-label {
  font-size: 26rpx;
  color: #7a7a7a;
  margin: 24rpx 8rpx 16rpx;
}

.tag-row {
  display: flex;
  margin-bottom: 8rpx;
}

.tag-chip {
  font-size: 26rpx;
  color: #1d1d1f;
  background: #ffffff;
  border: 1rpx solid #e0e0e0;
  border-radius: 9999px;
  padding: 14rpx 32rpx;
  margin-right: 20rpx;
  transition: all 0.2s ease;
}

.tag-chip--active {
  color: #ffffff;
  background: #0066cc;
  border-color: #0066cc;
  font-weight: 600;
}

/* 输入卡片 */
.field-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
}

.title-input {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  height: 64rpx;
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  font-size: 28rpx;
  color: #1d1d1f;
  line-height: 1.6;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 22rpx;
  color: #7a7a7a;
  margin-top: 12rpx;
}

/* 添加图片 */
.image-add {
  width: 200rpx;
  height: 200rpx;
  margin-top: 24rpx;
  background: #ffffff;
  border: 2rpx dashed #d2d2d7;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.image-add-icon {
  font-size: 56rpx;
  color: #7a7a7a;
  line-height: 1;
}

.image-add-text {
  font-size: 22rpx;
  color: #7a7a7a;
  margin-top: 12rpx;
}
