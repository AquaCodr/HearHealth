/* 帖子详情页 —— 设计 token 参考 DesignTemplate/apple-variables.css（1px≈2rpx） */

.detail-page {
  min-height: 100vh;
  background: #f5f5f7;
  box-sizing: border-box;
  padding: 24rpx 24rpx 180rpx;
}

/* 返回广场 + 板块标签栏 */
.detail-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  color: #0066cc;
}

.nav-back-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-right: 6rpx;
  font-weight: 600;
}

.nav-back-text {
  font-size: 28rpx;
  font-weight: 600;
}

.nav-tag {
  font-size: 22rpx;
  color: #0066cc;
  background: rgba(0, 102, 204, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 9999px;
}

/* 帖子主体卡片 */
.post-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 32rpx 28rpx;
}

.post-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #0066cc;
  background: rgba(0, 102, 204, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 9999px;
}

.post-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1d1d1f;
  line-height: 1.25;
  margin-top: 20rpx;
}

.author-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 9999px;
  background: #f0f0f0;
  flex-shrink: 0;
}

.author-meta {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.author-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.author-sub {
  font-size: 24rpx;
  color: #7a7a7a;
  margin-top: 4rpx;
}

.post-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.7;
  margin-top: 28rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.post-cover {
  margin-top: 24rpx;
  border-radius: 11rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.post-cover-img {
  width: 100%;
}

/* 互动按钮 */
.action-bar {
  display: flex;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #7a7a7a;
  padding: 12rpx 0;
  line-height: 1.4;
}

.action-item--active {
  color: #0066cc;
  font-weight: 600;
}

/* 简约图标（SVG image） */
.icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.action-share {
  margin: 0;
  padding: 12rpx 0;
  font-size: 26rpx;
  font-weight: 400;
  color: #7a7a7a;
  background: transparent;
  line-height: 1.4;
}

/* 评论区 */
.comment-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 32rpx 28rpx;
  margin-top: 20rpx;
}

.comment-header {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999px;
  background: #f0f0f0;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  margin-left: 16rpx;
}

.comment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-nickname {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.comment-time {
  font-size: 22rpx;
  color: #7a7a7a;
}

.comment-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.47;
  margin-top: 8rpx;
  word-break: break-all;
}

.comment-empty {
  text-align: center;
  color: #7a7a7a;
  font-size: 26rpx;
  padding: 48rpx 0 24rpx;
}

/* 底部评论输入栏 */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e0e0e0;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f7;
  border-radius: 9999px;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #1d1d1f;
}

.comment-send {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: #0066cc;
  border-radius: 9999px;
  padding: 14rpx 36rpx;
}

.comment-send--disabled {
  opacity: 0.4;
}

.loading-tip {
  text-align: center;
  color: #7a7a7a;
  font-size: 28rpx;
  margin-top: 120rpx;
}
