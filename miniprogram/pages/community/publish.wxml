<!-- 发帖编辑页 -->
<view class="publish-page">

  <!-- 进入幕布：从耳友圈位置展开铺满，再淡出，盖住生硬的页面切换 -->
  <view class="curtain-mask" wx:if="{{curtain.show}}" style="opacity: {{curtain.opacity}};">
    <view
      class="curtain-fill"
      style="clip-path: circle({{curtain.radius}}% at {{curtain.x}}% {{curtain.y}}%); -webkit-clip-path: circle({{curtain.radius}}% at {{curtain.x}}% {{curtain.y}}%);"
    ></view>
  </view>


  <!-- 顶部操作栏 -->
  <view class="action-bar">
    <view class="action-cancel" bindtap="onCancel">取消</view>
    <view class="action-title">发布帖子</view>
    <view class="action-publish {{publishing ? 'action-publish--disabled' : ''}}" bindtap="onPublish">
      {{publishing ? '发布中…' : '发布'}}
    </view>
  </view>

  <!-- 板块选择 -->
  <view class="section-label">选择板块</view>
  <view class="tag-row">
    <view
      class="tag-chip {{activeTag === item.key ? 'tag-chip--active' : ''}}"
      wx:for="{{tags}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSelectTag"
    >{{item.label}}</view>
  </view>

  <!-- 标题输入 -->
  <view class="field-card">
    <input
      class="title-input"
      placeholder="起一个吸引人的标题吧"
      maxlength="40"
      value="{{title}}"
      bindinput="onTitleInput"
    />
  </view>

  <!-- 内容输入 -->
  <view class="field-card">
    <textarea
      class="content-input"
      placeholder="分享你的护耳经验、翻车经历或耳机测评…"
      maxlength="{{maxLen}}"
      value="{{content}}"
      bindinput="onContentInput"
      auto-height="true"
    />
    <view class="word-count">{{content.length}}/{{maxLen}}</view>
  </view>

  <!-- 图片选择（最多 3 张，可预览/删除） -->
  <view class="image-grid">
    <view class="image-item" wx:for="{{images}}" wx:key="*this">
      <image
        class="image-thumb"
        src="{{item}}"
        mode="aspectFill"
        data-src="{{item}}"
        bindtap="onPreviewImage"
      ></image>
      <view class="image-remove" data-index="{{index}}" catchtap="onRemoveImage">×</view>
    </view>
    <view class="image-add" wx:if="{{images.length < maxImages}}" bindtap="onChooseImage">
      <view class="image-add-icon">+</view>
      <view class="image-add-text">{{images.length}}/{{maxImages}}</view>
    </view>
  </view>
</view>
