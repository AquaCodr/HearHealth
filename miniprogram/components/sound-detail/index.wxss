:host { display: block; }
.detail-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 24rpx 56rpx; background: #f5f5f7; }
.range-switch { display: grid; grid-template-columns: repeat(6, 1fr); padding: 6rpx; border-radius: 999rpx; background: #e9e9eb; }
.range-option { display: flex; align-items: center; justify-content: center; min-width: 0; height: 66rpx; color: #333333; font-size: 24rpx; font-weight: 500; border-radius: 999rpx; }
.range-option--selected { color: #1d1d1f; font-weight: 600; background: #ffffff; box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06); }
.range-option--pressed { opacity: 0.62; }

.status-panel { display: flex; align-items: center; justify-content: space-between; padding: 36rpx 8rpx 24rpx; }
.status-copy { display: flex; flex-direction: column; min-width: 0; }
.status-label { color: #7a7a7a; font-size: 25rpx; font-weight: 600; }
.status-value-row { display: flex; align-items: center; margin-top: 10rpx; }
.status-check { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; margin-right: 14rpx; color: #ffffff; font-size: 34rpx; font-weight: 700; line-height: 1; border-radius: 50%; background: #34c759; }
.status-value { color: #1d1d1f; font-size: 52rpx; font-weight: 700; line-height: 1.12; }
.date-range { margin-top: 10rpx; color: #7a7a7a; font-size: 28rpx; font-weight: 500; }
.info-button { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; color: #1d1d1f; font-family: Georgia, serif; font-size: 34rpx; font-weight: 700; border-radius: 50%; background: #ffffff; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05); }
.info-button--pressed { background: #e5e5ea; }

.chart-card { padding: 26rpx 22rpx 24rpx; overflow: hidden; border-radius: 26rpx; background: #ffffff; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04); }
.chart-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.chart-title { color: #1d1d1f; font-size: 30rpx; font-weight: 600; }
.chart-unit { color: #7a7a7a; font-size: 21rpx; }
.chart-area { width: 100%; }
.chart-plot { position: relative; height: 390rpx; margin-right: 58rpx; }
.grid-line { position: absolute; right: 0; left: 0; height: 2rpx; background: #e8e8ed; }
.grid-line--top { top: 0; }
.grid-line--middle { top: 50%; }
.grid-line--bottom { bottom: 0; }
.reference-line { position: absolute; z-index: 2; right: 0; left: 0; height: 4rpx; background: #0071e3; }
.reference-label { position: absolute; left: calc(100% + 10rpx); top: -17rpx; color: #0071e3; font-size: 21rpx; font-weight: 600; white-space: nowrap; }
.chart-bars { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; }
.chart-column { position: relative; flex: 1; height: 100%; border-right: 2rpx dashed #e1e1e6; }
.chart-column:first-child { border-left: 2rpx dashed #e1e1e6; }
.range-bar { position: absolute; left: 50%; width: 14rpx; min-height: 12rpx; border-radius: 14rpx; background: #0071e3; transform: translateX(-50%); }
.y-label { position: absolute; left: calc(100% + 10rpx); color: #9a9aa1; font-size: 20rpx; line-height: 1; }
.y-label--top { top: -5rpx; }
.y-label--middle { top: 50%; transform: translateY(-50%); }
.y-label--bottom { bottom: -5rpx; }
.x-axis { display: flex; margin-top: 12rpx; margin-right: 58rpx; }
.x-label { flex: 1; min-width: 0; overflow: hidden; color: #8a8a91; font-size: 19rpx; line-height: 1.2; text-align: center; text-overflow: clip; white-space: nowrap; }
.chart-description { margin-top: 22rpx; padding-top: 20rpx; color: #7a7a7a; font-size: 22rpx; line-height: 1.45; border-top: 2rpx solid #f0f0f0; }

.metric-list { margin-top: 22rpx; overflow: hidden; border-radius: 26rpx; background: #ffffff; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04); }
.metric-row { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; box-sizing: border-box; margin-left: 26rpx; padding: 20rpx 26rpx 20rpx 0; border-bottom: 2rpx solid #f0f0f0; }
.metric-row:last-child { border-bottom: none; }
.metric-row--primary { margin-left: 0; padding-left: 26rpx; background: #edf5ff; border-bottom-color: #d7eaff; }
.metric-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; padding-right: 18rpx; }
.metric-label { color: #1d1d1f; font-size: 27rpx; font-weight: 500; }
.metric-description { margin-top: 4rpx; color: #7a7a7a; font-size: 20rpx; line-height: 1.35; }
.metric-value { flex-shrink: 0; color: #1d1d1f; font-size: 27rpx; font-weight: 600; text-align: right; }
.metric-row--primary .metric-label,
.metric-row--primary .metric-value { color: #0066cc; }
.detail-footnote { padding: 24rpx 22rpx 0; color: #7a7a7a; font-size: 21rpx; line-height: 1.5; text-align: center; }
