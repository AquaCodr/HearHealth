.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.tabbar-glass {
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: calc(100% - 64rpx);
  max-width: 680rpx;
  margin: 0 auto;
  padding: 14rpx 12rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08), inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  pointer-events: auto;
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 22rpx 12rpx;
  border-radius: 9999rpx;
  color: #8e8e93;
  transition: color 0.25s ease;
}

.tab-bg {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%) scale(0.92);
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.06);
  opacity: 0;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.tab-item--active {
  color: #0066cc;
}

.tab-item--active .tab-bg {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.tab-text {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  font-weight: 500;
}

.tabbar-safe {
  width: 100%;
  height: calc(4rpx + env(safe-area-inset-bottom) / 2);
  background: transparent;
}
